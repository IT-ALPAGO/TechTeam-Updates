# ---------------------------------------------------------------------------
# Jira Cloud connection
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Your Atlassian site, without https:// and without a trailing slash.
JIRA_HOST=alpagoproperties-team-kjrj96st.atlassian.net

# The Atlassian account the dashboard reads as.
JIRA_EMAIL=you@alpago.com

# Create one at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_api_token_here

# Optional: restrict the dashboard to specific projects (comma separated keys).
# Leave blank to include every project the account can see.
# JIRA_PROJECTS=QAQC,FMS,FM,EOS,ACRM

# Port the API proxy listens on (the Vite dev server forwards /api here).
PORT=8787

# Only needed if you created an API token "with scopes" (Atlassian's recommended
# option). Scoped tokens are called through api.atlassian.com rather than your
# site URL. Leave blank for a classic token.
# Your site's cloud ID is: f03d1463-bd87-4687-8226-54f55e8bd44b
# JIRA_CLOUD_ID=
